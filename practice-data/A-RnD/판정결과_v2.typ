#set document(title: "구조 해석 결과 검토 체크리스트")
#set page(paper: "a4", margin: (x: 2.5cm, y: 2.5cm))
#set text(font: ("Malgun Gothic", "Noto Sans KR", "Arial"), size: 10pt, lang: "ko")
#set table(stroke: 0.5pt, inset: 6pt)

// 헤더
#align(center)[
  #text(size: 16pt, weight: "bold")[구조 해석 결과 검토 체크리스트]
]
#v(0.5em)

#grid(
  columns: (1fr, 1fr, 1fr),
  gutter: 0.5em,
  [*문서번호:* A-RnD-CHK-001],
  [*작성일:* 2026-04-09],
  [*적용 기준:* 사내 구조 설계 검토 기준 v2.0],
)

#line(length: 100%)
#v(0.5em)

// 1. 판정 기준
== 1. 판정 기준

#table(
  columns: (1fr, 1fr, 1fr),
  fill: (_, y) => if y == 0 { rgb("#d0e4f7") } else { white },
  [*항목*], [*기준값*], [*조건*],
  [최대응력], [500 MPa], [초과 시 불합격],
  [안전계수], [2.0], [미만 시 불합격],
)

#block(
  fill: rgb("#fff3cd"),
  inset: 8pt,
  radius: 4pt,
  width: 100%,
)[
  ⚠️ *주의:* 두 조건 중 하나라도 해당하면 불합격 처리한다.
]

#v(0.5em)

// 2. 부품별 검토 결과
== 2. 부품별 검토 결과

#table(
  columns: (1.2fr, 1.5fr, 1.3fr, 1.5fr, 1.3fr, 1.2fr, 2fr),
  fill: (_, y) => if y == 0 { rgb("#d0e4f7") } else if y == 3 or y == 5 or y == 6 or y == 7 or y == 10 { rgb("#ffe0e0") } else { white },
  [*부품번호*], [*최대응력(MPa)*], [*응력 기준*], [*안전계수*], [*안전계수 기준*], [*판정*], [*비고*],
  [A-001], [312.4], [✅], [3.2], [✅], [합격], [],
  [A-002], [487.1], [✅], [2.1], [✅], [합격], [],
  [A-003], [521.8], [❌], [1.9], [❌], [*불합격*], [응력 초과 + 안전계수 미달],
  [A-004], [198.3], [✅], [4.5], [✅], [합격], [],
  [A-005], [503.2], [❌], [2.3], [✅], [*불합격*], [응력 초과],
  [A-006], [445.6], [✅], [1.7], [❌], [*불합격*], [안전계수 미달],
  [A-007], [610.0], [❌], [1.4], [❌], [*불합격*], [응력 초과 + 안전계수 미달],
  [A-008], [278.9], [✅], [3.8], [✅], [합격], [],
  [A-009], [499.9], [✅], [2.0], [✅], [합격], [경계값 통과],
  [A-010], [534.7], [❌], [1.8], [❌], [*불합격*], [응력 초과 + 안전계수 미달],
)

#v(0.5em)

// 3. 결과 요약
== 3. 결과 요약

#table(
  columns: (1fr, 1fr, 3fr),
  fill: (_, y) => if y == 0 { rgb("#d0e4f7") } else if y == 1 { rgb("#e8f5e9") } else if y == 2 { rgb("#ffe0e0") } else { white },
  [*구분*], [*부품 수*], [*해당 부품*],
  [합격], [5], [A-001, A-002, A-004, A-008, A-009],
  [불합격], [5], [A-003, A-005, A-006, A-007, A-010],
)

#v(0.5em)

// 4. 불합격 원인별 분류
== 4. 불합격 원인별 분류

#table(
  columns: (2fr, 2fr),
  fill: (_, y) => if y == 0 { rgb("#d0e4f7") } else { white },
  [*불합격 사유*], [*해당 부품*],
  [응력 초과 단독], [A-005],
  [안전계수 미달 단독], [A-006],
  [응력 초과 + 안전계수 미달], [A-003, A-007, A-010],
)

#v(0.5em)

// 5. 검토 확인
== 5. 검토 확인

#table(
  columns: (3fr, 1fr, 2fr),
  fill: (_, y) => if y == 0 { rgb("#d0e4f7") } else { white },
  [*항목*], [*확인*], [*서명*],
  [판정 기준 적용 확인], [☐], [],
  [불합격 부품 재설계 의뢰], [☐], [],
  [경계값 부품(A-009) 재검토 여부], [☐], [],
)

#v(1em)
#line(length: 100%)

#grid(
  columns: (1fr, 1fr, 1fr),
  gutter: 1em,
  [*담당자:* #h(2cm) \_\_\_\_\_],
  [*검토일:* #h(2cm) \_\_\_\_\_],
  [*승인:* #h(2cm) \_\_\_\_\_],
)
